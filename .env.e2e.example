# Playwright E2E configuration - LOCAL / isolated TEST environment only.
# Frontend Vite URL (Playwright starts Vite automatically).
E2E_BASE_URL=replace-with-dedicated-test-value

# Backend origin. The frontend API client appends /api/v1.
VITE_API_BASE_URL=http://localhost:5000

# Replace these with a CUSTOMER account created in your dedicated test database.
# Do not use production credentials.
E2E_CUSTOMER_EMAIL=replace-with-dedicated-test-value
E2E_CUSTOMER_PASSWORD=replace-with-dedicated-test-value

# Optional role accounts. Keep placeholders until the matching role E2E tests are implemented.
E2E_ADMIN_EMAIL=replace-with-dedicated-test-value
E2E_ADMIN_PASSWORD=replace-with-dedicated-test-value
E2E_SUPPORT_EMAIL=replace-with-dedicated-test-value
E2E_SUPPORT_PASSWORD=replace-with-dedicated-test-value
E2E_AUDITOR_EMAIL=replace-with-dedicated-test-value
E2E_AUDITOR_PASSWORD=replace-with-dedicated-test-value
